        <mxCell id="23ouZBPq11SYYB3A6ERN-31" value="if any sequence is missing this call fetches those missing sequence and execute it along with other write request in sequence" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="23ouZBPq11SYYB3A6ERN-1" vertex="1">
          <mxGeometry x="180" y="650" width="690" height="30" as="geometry" />
        </mxCell>
        <mxCell id="23ouZBPq11SYYB3A6ERN-32" value="CRDT - Conflict-Free Replicated Data Type&lt;div&gt;- Convergent state CRDT&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Commutative operation CRDT&lt;br&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="23ouZBPq11SYYB3A6ERN-1" vertex="1">
          <mxGeometry x="-265" y="-122" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="-o0au63LBRwLxzCbq7Kk-0" value="&lt;div&gt;ProcessWriteRequestService -&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;request goes as below -&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;to, from, text, version, user id, location id, document id etc.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;above information saved in sql db as we need to know about the relationship between document id, location id , user id etc&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;once above information is saved by multiple users by appending the document&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;an event with operation details goes to message queue for each write with few details&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;this event is picked up by another service (PickwriteRequestService)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;this service fetches event from the message queue and saves the details in nosql database in sorted manner, sort by char location id and document id&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;and it also saves this details in another nosql db (vector db), this nosql db contains the latest version of each write request for each document id and server id&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;After above steps&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;PickWriteRequestService calls ProcessWriteRequestToOthersService&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;this service start implementing each write service in sequence based on version id, document id&lt;/div&gt;&lt;div&gt;if any sequence is missing then missing operation version can be fetched from sql db and applies to the document&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;and all writes taken care by doing this and all user gets the latest data of the document&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="23ouZBPq11SYYB3A6ERN-1" vertex="1">
          <mxGeometry x="-355" y="-530" width="860" height="400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
