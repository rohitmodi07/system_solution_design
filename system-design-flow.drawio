        <mxCell id="b-jtBINz3-ixhz1Lf9aJ-27" value="chat&lt;div&gt;db&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="b-jtBINz3-ixhz1Lf9aJ-1">
