              <mxPoint x="975" y="540" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="i4-_9sErrBNQxBBdTZkH-1" value="User upload the&amp;nbsp; file, file breaks down in chunk and those chunk goes to queue&lt;div&gt;FIleUploadService picks chunk one by one and call SubscriptionService to check if user has enough space&lt;/div&gt;&lt;div&gt;if not then propmt user to purchase and proceed with the task else proceed as usual&lt;/div&gt;&lt;div&gt;Now FIleUploadService send these chunk to S3 bucket and saves the metadata into DB&lt;/div&gt;&lt;div&gt;along with this saves chunk info in queue&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;NotificationService consume the event from queue and inform User to download the file, a call goes from user app to FIleProcessingService&lt;/div&gt;&lt;div&gt;f, this service fetches the info about the chunk from Metadata DB and download the file from S3 bucket and send it to User&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="60" y="640" width="760" height="140" as="geometry" />
        </mxCell>
