          <mxGeometry x="110" y="-62" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="_H5GccZpeiWx0nXgQytD-30" value="keep track of all the server and its congif, provide backup, snapshots, provide recovery etc." style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="_H5GccZpeiWx0nXgQytD-1" vertex="1">
          <mxGeometry x="55" y="-262" width="510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="DWbBXcmTHpUe67rXriFF-0" value="&lt;span style=&quot;color: rgb(240, 240, 240); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;An application send the message to queue, now cacheService pick this message and format it and forward to ClientCacheService, clientCacheService call Zookeeper who manages all the gemfire cluster&lt;/span&gt;&lt;div style=&quot;forced-color-adjust: none; border-color: rgb(0, 0, 0); color: rgb(240, 240, 240); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;and have all the information, send all these info to ClientCacheService, now clientcacheservice uses cosnsistent hashing to pick the most suitable server to process the request, if its put, it will save the info , if its get then it gets the data&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; border-color: rgb(0, 0, 0); color: rgb(240, 240, 240); font-family: Helvetica; font-size: 12px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: center; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: nowrap; background-color: rgb(27, 29, 30); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial;&quot;&gt;later point of time, data will move to nosql database&amp;nbsp;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" parent="_H5GccZpeiWx0nXgQytD-1" vertex="1">
          <mxGeometry x="-510" y="-380" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="O9dzJ6GnJUWxdi-AsyuQ-0" value="queue" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" vertex="1" parent="_H5GccZpeiWx0nXgQytD-1">
          <mxGeometry x="-380" y="240" width="70" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
