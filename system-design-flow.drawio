        <mxCell id="5dvBRP3CVS0ZlE2KNMk1-13" value="Copyright © 2025 Tech-Maze Info - All Rights Reserved." style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="5dvBRP3CVS0ZlE2KNMk1-1">
          <mxGeometry x="100" y="460" width="670" height="50" as="geometry" />
        </mxCell>
        <mxCell id="5dvBRP3CVS0ZlE2KNMk1-14" value="&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;All dropdown must contains constant value, values i will share&amp;nbsp;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="5dvBRP3CVS0ZlE2KNMk1-1">
          <mxGeometry x="-140" y="638" width="580" height="30" as="geometry" />
        </mxCell>
        <mxCell id="5dvBRP3CVS0ZlE2KNMk1-15" value="Unit type - mostly would be -&lt;br&gt;&lt;div style=&quot;color: rgb(204, 204, 204); background-color: rgb(31, 31, 31); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space-collapse: preserve;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;       const&lt;/span&gt; &lt;span style=&quot;color: #4fc1ff;&quot;&gt;unitdropdown&lt;/span&gt; &lt;span style=&quot;color: #d4d4d4;&quot;&gt;=&lt;/span&gt; [&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                       { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;length&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;length&#39;&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                  { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;area&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;area&#39;&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                  { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;mass&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;mass&#39;&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                      { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;volume&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;volume&#39;&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                                          { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;volume flow rate&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;volume flow rate&#39;&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                                { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;temperature&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;temperature&#39;&lt;/span&gt; },&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;                         { &lt;span style=&quot;color: #9cdcfe;&quot;&gt;value&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;digital&#39;&lt;/span&gt;, &lt;span style=&quot;color: #9cdcfe;&quot;&gt;label&lt;/span&gt;&lt;span style=&quot;color: #9cdcfe;&quot;&gt;:&lt;/span&gt; &lt;span style=&quot;color: #ce9178;&quot;&gt;&#39;digital&#39;&lt;/span&gt; }];&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="5dvBRP3CVS0ZlE2KNMk1-1">
          <mxGeometry x="-255" y="583" width="810" height="200" as="geometry" />
        </mxCell>
        <mxCell id="5dvBRP3CVS0ZlE2KNMk1-16" value="On selection of unit type show From and To drop down, both must contains&amp;nbsp;&lt;div&gt;the same value so that we can convert in any unit to any unit&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="5dvBRP3CVS0ZlE2KNMk1-1">
          <mxGeometry x="70" y="790" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="5dvBRP3CVS0ZlE2KNMk1-17" value="to use the conversion method, install convert-units library&amp;nbsp;&lt;br&gt;npm install convert-units --save" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="5dvBRP3CVS0ZlE2KNMk1-1">
          <mxGeometry x="70" y="840" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="5dvBRP3CVS0ZlE2KNMk1-18" value="then call its one of the method as below -&amp;nbsp;&lt;br&gt;convert(1).from(&#39;km&#39;).to(&#39;m&#39;);" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="5dvBRP3CVS0ZlE2KNMk1-1">
          <mxGeometry x="70" y="903" width="240" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
